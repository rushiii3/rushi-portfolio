---
// src/components/CookieConsent.astro
// Zero-dependency, zero-React cookie consent banner with Google Consent Mode v2 support
---

<div
  id="cookie-banner"
  class="hidden fixed bottom-5 left-5 right-5 max-w-md mx-auto sm:mx-0 rounded-2xl border border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-5 shadow-2xl z-50 transition-all text-neutral-900 dark:text-neutral-100"
  role="region"
  aria-label="Cookie consent banner"
>
  <p class="font-bold text-base flex items-center gap-2">
    <span>🍪</span> Cookie Notice
  </p>

  <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
    We use cookies to analyze traffic and improve your browsing experience. You can choose which cookies to accept.
  </p>

  <div class="mt-4 flex flex-col gap-2">
    <button
      type="button"
      id="cookie-accept-all"
      class="w-full py-2 px-4 rounded-xl text-sm font-semibold bg-neutral-900 hover:bg-neutral-800 dark:bg-white dark:hover:bg-neutral-200 text-white dark:text-neutral-900 transition-colors shadow-xs"
    >
      Allow all
    </button>
    <div class="grid grid-cols-2 gap-2">
      <button
        type="button"
        id="cookie-manage-btn"
        class="w-full py-2 px-3 rounded-xl text-sm font-medium border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-800 dark:text-neutral-200 transition-colors"
      >
        Manage
      </button>
      <button
        type="button"
        id="cookie-deny-all"
        class="w-full py-2 px-3 rounded-xl text-sm font-medium border border-red-300 dark:border-red-900/60 bg-red-50 dark:bg-red-950/30 text-red-600 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900/40 transition-colors"
      >
        Deny
      </button>
    </div>
  </div>
</div>

<!-- Modal for managing cookies -->
<dialog
  id="cookie-modal"
  class="backdrop:bg-black/60 rounded-2xl border border-neutral-300 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-6 max-w-lg w-full text-neutral-900 dark:text-white shadow-2xl m-auto"
>
  <div class="flex flex-col gap-4">
    <div class="flex items-center justify-between pb-3 border-b border-neutral-200 dark:border-neutral-800">
      <h3 class="text-lg font-bold">Manage Cookie Preferences</h3>
      <button
        type="button"
        id="cookie-modal-close"
        class="text-neutral-500 hover:text-neutral-800 dark:hover:text-neutral-200 p-1"
        aria-label="Close dialog"
      >
        &times;
      </button>
    </div>

    <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400">
      We use cookies to enhance your browsing experience, analyze site traffic, and personalize content. You can toggle each category below.
    </p>

    <div class="space-y-4 my-2 text-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-semibold text-neutral-900 dark:text-white">Essential Cookies</p>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">Required for the website to function. Cannot be disabled.</p>
        </div>
        <input type="checkbox" checked disabled class="mt-1 size-4 accent-neutral-900 dark:accent-white" />
      </div>

      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-semibold text-neutral-900 dark:text-white">Analytics Cookies</p>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">Help us understand how visitors interact with our website.</p>
        </div>
        <input type="checkbox" id="consent-analytics" class="mt-1 size-4 accent-neutral-900 dark:accent-white" />
      </div>

      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-semibold text-neutral-900 dark:text-white">Advertising Cookies</p>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">Used to deliver personalized advertisements.</p>
        </div>
        <input type="checkbox" id="consent-ads" class="mt-1 size-4 accent-neutral-900 dark:accent-white" />
      </div>

      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-semibold text-neutral-900 dark:text-white">Functional Cookies</p>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">Enable enhanced functionality like embedded media.</p>
        </div>
        <input type="checkbox" id="consent-functional" class="mt-1 size-4 accent-neutral-900 dark:accent-white" />
      </div>
    </div>

    <div class="flex flex-col-reverse sm:flex-row items-center justify-end gap-2 pt-3 border-t border-neutral-200 dark:border-neutral-800">
      <button
        type="button"
        id="cookie-modal-deny"
        class="w-full sm:w-auto px-4 py-2 rounded-xl text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 transition-colors"
      >
        Deny All
      </button>
      <button
        type="button"
        id="cookie-modal-save"
        class="w-full sm:w-auto px-4 py-2 rounded-xl text-xs font-semibold border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
      >
        Allow Selected
      </button>
      <button
        type="button"
        id="cookie-modal-accept"
        class="w-full sm:w-auto px-4 py-2 rounded-xl text-xs font-semibold bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors shadow-xs"
      >
        Allow All
      </button>
    </div>
  </div>
</dialog>

<script is:inline>
  (function () {
    const banner = document.getElementById('cookie-banner');
    const modal = document.getElementById('cookie-modal');
    const analyticsCb = document.getElementById('consent-analytics');
    const adsCb = document.getElementById('consent-ads');
    const functionalCb = document.getElementById('consent-functional');

    function updateConsent(analytics, ads, functional) {
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: analytics ? 'granted' : 'denied',
          ad_storage: ads ? 'granted' : 'denied',
          ad_user_data: ads ? 'granted' : 'denied',
          ad_personalization: ads ? 'granted' : 'denied',
          functionality_storage: functional ? 'granted' : 'denied',
        });
      }
      localStorage.setItem(
        'cookie-consent',
        JSON.stringify({ analytics, ads, functional })
      );
      if (banner) banner.classList.add('hidden');
      if (modal && modal.open) modal.close();
    }

    try {
      const stored = localStorage.getItem('cookie-consent');
      if (!stored) {
        setTimeout(() => {
          if (banner) banner.classList.remove('hidden');
        }, 1500);
      } else {
        const parsed = JSON.parse(stored);
        if (analyticsCb) analyticsCb.checked = Boolean(parsed.analytics);
        if (adsCb) adsCb.checked = Boolean(parsed.ads);
        if (functionalCb) functionalCb.checked = Boolean(parsed.functional);

        if (typeof window.gtag === 'function') {
          window.gtag('consent', 'update', {
            analytics_storage: parsed.analytics ? 'granted' : 'denied',
            ad_storage: parsed.ads ? 'granted' : 'denied',
            ad_user_data: parsed.ads ? 'granted' : 'denied',
            ad_personalization: parsed.ads ? 'granted' : 'denied',
            functionality_storage: parsed.functional ? 'granted' : 'denied',
          });
        }
      }
    } catch (e) {}

    document.getElementById('cookie-accept-all')?.addEventListener('click', () => {
      updateConsent(true, true, true);
    });

    document.getElementById('cookie-deny-all')?.addEventListener('click', () => {
      updateConsent(false, false, false);
    });

    document.getElementById('cookie-manage-btn')?.addEventListener('click', () => {
      if (modal && typeof modal.showModal === 'function') {
        modal.showModal();
      }
    });

    document.getElementById('cookie-modal-close')?.addEventListener('click', () => {
      if (modal) modal.close();
    });

    document.getElementById('cookie-modal-deny')?.addEventListener('click', () => {
      updateConsent(false, false, false);
    });

    document.getElementById('cookie-modal-accept')?.addEventListener('click', () => {
      updateConsent(true, true, true);
    });

    document.getElementById('cookie-modal-save')?.addEventListener('click', () => {
      updateConsent(
        Boolean(analyticsCb?.checked),
        Boolean(adsCb?.checked),
        Boolean(functionalCb?.checked)
      );
    });
  })();
</script>
