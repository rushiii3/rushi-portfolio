---
// src/components/Navbar.astro
const pathname = Astro.url.pathname;

export const navItems = [
  { id: 1, label: "Home", href: "/", icon: "home" },
  { id: 2, label: "About", href: "/about", icon: "user" },
  { id: 3, label: "Experience", href: "/experience", icon: "briefcase" },
  { id: 4, label: "Work", href: "/work", icon: "work" },
  { id: 5, label: "Blog", href: "/blog", icon: "book" },
] as const;

function isTabActive(href: string): boolean {
  if (href === "/") {
    return pathname === "/" || pathname === "";
  }
  return pathname.startsWith(href);
}
---

<nav aria-label="Main Navigation">
  <div class="z-40 flex justify-center items-center space-x-1 rounded-xl p-2 border border-neutral-200/60 dark:border-white/10 fixed left-1/2 -translate-x-1/2 bottom-3 md:relative md:left-0 md:translate-x-0 md:bottom-0 bg-white/40 dark:bg-[#0a0a0a]/40 backdrop-blur-md transition-all duration-300 ease-out animate-in fade-in slide-in-from-bottom-2 md:slide-in-from-top-2">
    {navItems.map((tab) => {
      const active = isTabActive(tab.href);
      return (
        <div class="flex flex-row items-center">
          <a
            href={tab.href}
            aria-label={tab.label}
            aria-current={active ? "page" : undefined}
            class:list={[
              "relative rounded-xl cursor-pointer px-3 py-2 min-h-11 text-sm font-medium outline-sky-400 transition focus-visible:outline-2 flex flex-row items-center gap-2",
              active
                ? "text-black dark:text-white"
                : "text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white",
            ]}
          >
            {active && (
              <span
                class="absolute inset-0 z-10 dark:bg-white mix-blend-difference rounded-xl bg-black transition-all"
                style="border-radius: 10px;"
              />
            )}

            {tab.icon === "home" && (
              <svg
                class="size-4.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                />
              </svg>
            )}
            {tab.icon === "user" && (
              <svg
                class="size-4.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                />
              </svg>
            )}
            {tab.icon === "briefcase" && (
              <svg
                class="size-4.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                />
              </svg>
            )}
            {tab.icon === "work" && (
              <svg
                class="size-4.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
                />
              </svg>
            )}
            {tab.icon === "book" && (
              <svg
                class="size-4.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                />
              </svg>
            )}

            {tab.id !== 1 && <span class="hidden lg:block">{tab.label}</span>}
          </a>
          {tab.id === 1 && (
            <div
              class="bg-neutral-300 dark:bg-white/30 w-px h-6 mx-1"
              aria-hidden="true"
            />
          )}
        </div>
      );
    })}
  </div>
</nav>
