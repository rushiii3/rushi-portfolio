---
// src/components/ProjectCard.astro
import { getOptimizedImageUrl, getImageSrcSet } from '../lib/images';

interface Project {
  slug: string;
  title: string;
  description: string;
  image: string;
  date: string;
  category: string;
  type?: string;
  stack: string[];
  github?: string;
  link?: string;
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="w-full group border border-neutral-200 dark:border-white/10 bg-neutral-50/40 dark:bg-neutral-900/40 rounded-2xl p-4 flex flex-col gap-4 h-full transition-all hover:border-neutral-400 dark:hover:border-neutral-600">
  <div class="relative rounded-2xl aspect-video overflow-hidden">
    <a href={`/work/${project.slug}`} aria-label={`View details for ${project.title}`}>
      <img
        src={getOptimizedImageUrl(project.image, 600)}
        srcset={getImageSrcSet(project.image, [400, 600, 800])}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
        alt={`project image for ${project.title}`}
        width="600"
        height="338"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </a>
  </div>

  <div class="flex flex-row gap-2 justify-between items-center w-full">
    {project.type && (
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-neutral-200/80 dark:bg-neutral-800 text-neutral-800 dark:text-neutral-200">
        {project.type}
      </span>
    )}
  </div>

  <div class="flex flex-col gap-1.5">
    <h3 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 hover:underline">
      <a href={`/work/${project.slug}`}>{project.title}</a>
    </h3>
    <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-3 leading-relaxed">
      {project.description}
    </p>
  </div>

  <div class="flex flex-row flex-wrap gap-1.5 my-1">
    {project.stack.map((tag) => (
      <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300">
        {tag}
      </span>
    ))}
  </div>

  <div class="mt-auto flex flex-row gap-2 justify-between items-center w-full pt-3 border-t border-neutral-200/60 dark:border-neutral-800">
    <p class="text-xs font-medium text-neutral-600 dark:text-neutral-400">{project.date}</p>
    <div class="flex flex-row items-center gap-2">
      {project.github && (
        <a
          href={project.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`View ${project.title} source code on GitHub`}
          class="p-2 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors"
        >
          <svg class="size-4" fill="currentColor" viewBox="0 0 16 16">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
          </svg>
        </a>
      )}
      {project.link && (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visit live site for ${project.title}`}
          class="p-2 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors"
        >
          <svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>
  </div>
</div>
