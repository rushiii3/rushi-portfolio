---
// src/components/RelatedArticles.astro
import type { BlogPost } from '../lib/content';
import { calculateReadingMinutes } from '../lib/content';

interface Props {
  articles: BlogPost[];
}

const { articles = [] } = Astro.props;
---

{articles.length > 0 && (
  <section aria-labelledby="related-articles-title" class="mt-14 pt-10 border-t border-neutral-200 dark:border-neutral-800">
    <div class="flex items-center justify-between mb-6">
      <h2 id="related-articles-title" class="text-xl md:text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100">
        Related Articles
      </h2>
      <a
        href="/blog"
        class="text-xs md:text-sm font-medium text-neutral-600 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white transition-colors"
      >
        View all &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {articles.map((article) => {
        const slug = article.id.replace(/\.mdx$/, '');
        const readingMinutes = calculateReadingMinutes(article.body);
        return (
          <a
            href={`/blog/${slug}`}
            class="group flex flex-col justify-between p-4 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/40 hover:border-neutral-400 dark:hover:border-neutral-600 transition-all"
          >
            <div>
              <div class="flex items-center gap-2 mb-2.5">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider border border-neutral-300 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200">
                  {article.data.category}
                </span>
                {readingMinutes > 0 && (
                  <span class="text-[11px] text-neutral-600 dark:text-neutral-400">
                    {readingMinutes} min read
                  </span>
                )}
              </div>
              <h3 class="font-semibold text-sm md:text-base leading-snug group-hover:text-neutral-900 dark:group-hover:text-white transition-colors line-clamp-2 mb-2 text-neutral-800 dark:text-neutral-200">
                {article.data.title}
              </h3>
              <p class="text-xs text-neutral-600 dark:text-neutral-400 line-clamp-3 leading-relaxed">
                {article.data.description}
              </p>
            </div>
            <div class="mt-4 pt-2 border-t border-neutral-100 dark:border-neutral-800/80 flex items-center justify-end text-xs font-medium text-neutral-600 dark:text-neutral-300 group-hover:text-neutral-900 dark:group-hover:text-white transition-colors">
              Read article &rarr;
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}
