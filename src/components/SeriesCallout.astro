---
// src/components/SeriesCallout.astro
import { getSeriesBlogs } from '../lib/content';

interface Props {
  seriesName?: string;
  currentSlug: string;
  currentOrder?: number;
}

const { seriesName, currentSlug, currentOrder } = Astro.props;

const seriesPosts = seriesName ? await getSeriesBlogs(seriesName) : [];
---

{seriesPosts.length > 1 && (
  <div class="my-6 p-4 md:p-5 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/30 text-neutral-900 dark:text-neutral-200">
    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider mb-2">
      <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <span>
        Series: {seriesName} {currentOrder ? `• Part ${currentOrder} of ${seriesPosts.length}` : ""}
      </span>
    </div>
    <p class="text-xs md:text-sm text-neutral-600 dark:text-neutral-400 mb-3">
      This article is part of a structured guide to foundational cybersecurity principles and network architecture.
    </p>

    <details class="group">
      <summary class="flex items-center justify-between text-xs font-medium hover:underline cursor-pointer list-none py-1">
        <span>View all {seriesPosts.length} chapters in this series</span>
        <svg class="size-3.5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <ol class="mt-3 space-y-2 pt-3 border-t border-neutral-200 dark:border-neutral-800 text-xs">
        {seriesPosts.map((post, idx) => {
          const isCurrent = post.id === currentSlug || post.id === `${currentSlug}.mdx`;
          return (
            <li class="flex items-start gap-2">
              <span class="font-mono text-neutral-600 dark:text-neutral-400 shrink-0">
                {idx + 1}.
              </span>
              {isCurrent ? (
                <span class="font-semibold text-neutral-900 dark:text-white" aria-current="page">
                  {post.data.title}{" "}
                  <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-neutral-100 dark:bg-neutral-800 border border-neutral-300 dark:border-neutral-700 text-neutral-800 dark:text-neutral-200 ml-1.5">
                    Current
                  </span>
                </span>
              ) : (
                <a
                  href={`/blog/${post.id.replace(/\.mdx$/, '')}`}
                  class="hover:text-blue-600 dark:hover:text-blue-400 hover:underline transition-colors line-clamp-1"
                >
                  {post.data.title}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </details>
  </div>
)}
