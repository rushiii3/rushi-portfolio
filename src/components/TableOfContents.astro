---
interface Props {
  headings?: { depth: number; slug: string; text: string }[];
}

const { headings = [] } = Astro.props;
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{tocItems.length >= 3 && (
  <nav aria-label="Table of contents" class="my-6">
    <details class="group p-4 md:p-5 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40">
      <summary class="flex items-center justify-between font-semibold text-sm text-neutral-900 dark:text-neutral-100 cursor-pointer list-none select-none">
        <div class="flex items-center gap-2">
          <svg class="size-4 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
          <span>Table of Contents</span>
          <span class="text-xs font-normal text-neutral-600 dark:text-neutral-400">
            ({tocItems.length} sections)
          </span>
        </div>
        <svg class="size-4 text-neutral-500 dark:text-neutral-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <ol class="mt-3.5 space-y-1 pt-3 border-t border-neutral-200/80 dark:border-neutral-800 text-xs md:text-sm">
        {tocItems.map((item) => (
          <li class={item.depth === 3 ? "pl-4 text-neutral-600 dark:text-neutral-400" : "text-neutral-700 dark:text-neutral-300 font-medium"}>
            <a
              href={`#${item.slug}`}
              class="hover:text-neutral-900 dark:hover:text-white transition-colors hover:underline block py-0.5 line-clamp-1"
            >
              {item.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  </nav>
)}
