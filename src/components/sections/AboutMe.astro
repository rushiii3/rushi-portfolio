---
// src/components/sections/AboutMe.astro
import SectionTitle from '../SectionTitle.astro';
import { personalInfo } from '@/data/info';
---

<section class="py-12 lg:py-16 w-full">
  <div class="w-full text-left">
    <SectionTitle title="About me" className="text-5xl md:text-7xl font-bold tracking-tighter leading-tight mb-8" />
    <div class="w-full text-base font-normal leading-7 text-justify text-neutral-800 dark:text-neutral-200 space-y-4">
      {personalInfo.description.split("\n\n").map((para) => (
        <p>{para}</p>
      ))}
    </div>
  </div>
</section>
