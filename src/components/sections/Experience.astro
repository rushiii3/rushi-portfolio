---
// src/components/sections/Experience.astro
import SectionTitle from "../SectionTitle.astro";
import { workExperienceData } from "../../data/info";
---

<section class="w-full py-12 lg:py-16 text-neutral-900 dark:text-white">
  <SectionTitle
    title="Work Experience"
    className="text-5xl md:text-7xl font-bold tracking-tighter leading-tight mb-10"
  />

  <ol class="ml-3 space-y-12 border-l border-neutral-200 dark:border-neutral-800">
    {workExperienceData.map((item) => (
      <li class="relative pl-8 md:pl-10">
        <!-- Timeline dot -->
        <span
          aria-hidden="true"
          class="absolute -left-[5.5px] top-2 size-2.5 rounded-full bg-emerald-500 ring-4 ring-white dark:bg-emerald-400 dark:ring-black"
        ></span>

        <header class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="text-xl font-bold md:text-2xl">{item.title}</h3>
          <span class="shrink-0 font-mono text-xs text-neutral-600 dark:text-neutral-400 md:text-sm">
            {item.timeline}
          </span>
        </header>

        <p class="mt-1 text-sm font-medium text-emerald-600 dark:text-emerald-400">
          {item.subtitle}
        </p>

        <ul class="mt-4 list-disc space-y-2 pl-4 text-sm leading-relaxed text-neutral-800 marker:text-emerald-500 dark:text-neutral-200 md:text-base">
          {item.content.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>
