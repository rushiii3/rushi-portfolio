---
// src/components/sections/Experience.astro
import { workExperienceData } from '../../data/info';
---

<section class="py-12 lg:py-16 w-full">
  <div class="w-full">
    <h2 class="text-6xl md:text-8xl font-bold tracking-tighter leading-tight md:pr-8 mb-8 text-neutral-900 dark:text-white">
      Work Experience
    </h2>

    <div class="relative mx-auto pb-12">
      <!-- Continuous vertical timeline bar -->
      <div
        aria-hidden="true"
        class="absolute left-4 md:left-5 top-4 bottom-0 w-0.5 bg-gradient-to-b from-purple-500 via-blue-500 to-transparent"
      ></div>

      <div class="space-y-12">
        {workExperienceData.map((item) => (
          <div class="relative flex items-start gap-6 md:gap-10">
            <!-- Timeline dot -->
            <div class="relative z-10 flex items-center justify-center shrink-0 w-8 md:w-10 h-8 md:h-10 rounded-full bg-white dark:bg-black border-2 border-primary/50 shadow-sm mt-1">
              <div class="w-2.5 h-2.5 rounded-full bg-[#07a97d]"></div>
            </div>

            <!-- Content card -->
            <div class="flex-1 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/30 p-6 md:p-8">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-4">
                <div>
                  <h3 class="text-xl md:text-2xl font-bold text-neutral-900 dark:text-white">
                    {item.title}
                  </h3>
                  <p class="text-sm font-medium italic text-[#07a97d]">
                    {item.subtitle}
                  </p>
                </div>
                <span class="text-xs md:text-sm font-mono text-neutral-600 dark:text-neutral-400 shrink-0">
                  {item.timeline}
                </span>
              </div>

              <ul class="list-disc marker:text-[#07a97d] list-outside space-y-2 text-neutral-800 dark:text-neutral-200 text-sm md:text-base pl-4 leading-relaxed">
                {item.content.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
