---
// src/pages/about.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutMe from "../components/sections/AboutMe.astro";
import Skills from "../components/sections/Skills.astro";
import { buildBreadcrumbSchema, buildPersonSchema } from "../lib/schemaBuilder";

const siteUrl = `${process.env.PUBLIC_URL || import.meta.env.PUBLIC_URL}`;
const personSchema = buildPersonSchema(siteUrl);
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${siteUrl}/` },
  { name: "About", url: `${siteUrl}/about` },
]);

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [personSchema, breadcrumbSchema],
};
---

<BaseLayout
  title="About Me | Hrushikesh Shinde"
  description="Learn about Hrushikesh Shinde: Application Security Consultant with expertise in penetration testing, threat modeling, security methodology, and DevSecOps."
  canonical="/about"
  jsonLd={jsonLdGraph}
>
  <div class="w-full md:pt-14 pt-8">
    <h1 class="sr-only">About Hrushikesh Shinde</h1>
    <AboutMe />
    <Skills />
  </div>
</BaseLayout>
