---
// src/pages/blog/[slug].astro
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import SeriesCallout from "../../components/SeriesCallout.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";
import BlogPostNavigation from "../../components/BlogPostNavigation.astro";
import ShareArticle from "../../components/ShareArticle.astro";
import CopyButton from "../../components/mdx/CopyButton.astro";
import Screenshot from "../../components/mdx/Screenshot.astro";
import Accordion from "../../components/mdx/Accordion.astro";
import AccordionItem from "../../components/mdx/AccordionItem.astro";
import AccordionTrigger from "../../components/mdx/AccordionTrigger.astro";
import AccordionContent from "../../components/mdx/AccordionContent.astro";
import Table from "../../components/mdx/Table.astro";
import {
  getAllBlogs,
  getRelatedBlogs,
  calculateReadingMinutes,
  extractContentImages,
  resolveBlogNavigation,
  type BlogPost,
} from "../../lib/content";
import { blogCategories } from "../../data/info";
import {
  buildBlogSchema,
  buildBreadcrumbSchema,
  buildFAQSchema,
} from "../../lib/schemaBuilder";
import { formatDisplayDate } from "../../lib/helper";
import { getOptimizedImageUrl, getImageSrcSet } from "../../lib/images";

export async function getStaticPaths() {
  const blogs = await getAllBlogs();
  return blogs.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx$/, "") },
    props: { entry },
  }));
}

interface Props {
  entry: BlogPost;
}

const { entry } = Astro.props;
const slug = entry.id.replace(/\.mdx$/, "");
const { Content, headings } = await render(entry);

const siteUrl = `${process.env.PUBLIC_URL || import.meta.env.PUBLIC_URL}`;
const canonical = `/blog/${slug}`;
const canonicalUrl = `${siteUrl}${canonical}`;
const logoUrl = `${siteUrl}/icon1.png`;
const authorUrl = `${siteUrl}/about`;

const rawContent = entry.body || "";
const words = rawContent.trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = calculateReadingMinutes(rawContent);
const contentImages = extractContentImages(rawContent);

const categorySlug =
  blogCategories.find(
    (c) => c.name.toLowerCase() === entry.data.category.toLowerCase(),
  )?.slug || "all";

const articleJsonLd = buildBlogSchema({
  title: entry.data.title,
  description: entry.data.description,
  publishedAt: entry.data.date,
  modifiedAt: entry.data.dateModified || entry.data.date,
  canonicalUrl,
  imageUrl: entry.data.image,
  contentImages,
  keywords: entry.data.keywords,
  wordCount: words,
  logoUrl,
  authorUrl,
  category: entry.data.category,
  readingMinutes,
});

const faqJsonLd = entry.data.faqSchema
  ? buildFAQSchema(entry.data.faqSchema)
  : null;

const breadcrumbJsonLd = buildBreadcrumbSchema([
  { name: "Home", url: `${siteUrl}/` },
  { name: "Blog", url: `${siteUrl}/blog` },
  {
    name: entry.data.category,
    url: `${siteUrl}/blog/category/${categorySlug}`,
  },
  { name: entry.data.title, url: canonicalUrl },
]);

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [
    articleJsonLd,
    ...(faqJsonLd ? [faqJsonLd] : []),
    breadcrumbJsonLd,
  ],
};

const allBlogs = await getAllBlogs();
const navigation = resolveBlogNavigation(allBlogs, slug);
const relatedArticles = await getRelatedBlogs(
  slug,
  entry.data.category,
  entry.data.keywords,
  3,
);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonical}
  ogImage={entry.data.image}
  ogType="article"
  publishedTime={entry.data.date}
  modifiedTime={entry.data.dateModified || entry.data.date}
  keywords={entry.data.keywords}
  jsonLd={jsonLdGraph}
>
  <div class="md:pt-32 pt-16 w-full dark:text-white text-black pb-20">
    <article>
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Blog", href: "/blog" },
          {
            label: entry.data.category,
            href: `/blog/category/${categorySlug}`,
          },
          { label: entry.data.title },
        ]}
      />

      <a href={`/blog/category/${categorySlug}`} class="inline-block mb-3">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-neutral-900 text-white hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200 transition-colors cursor-pointer">
          {entry.data.category}
        </span>
      </a>

      <h1 class="text-3xl md:text-4xl lg:text-6xl font-black leading-tight tracking-tight">
        {entry.data.title}
      </h1>

      <p class="text-lg text-slate-700 dark:text-slate-400 max-w-3xl leading-relaxed mt-4">
        {entry.data.description}
      </p>

      <!-- Metadata strip -->
      <div class="flex items-center border-y dark:border-white/10 border-black/10 py-6 justify-center my-6">
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-xs md:text-sm font-medium dark:text-slate-400 text-slate-600">
          <div class="flex items-center gap-2">
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <span>
              Published on:{" "}
              <span class="dark:text-slate-300 text-slate-600">
                {formatDisplayDate(entry.data.date)}
              </span>
            </span>
          </div>

          <span class="hidden md:block w-1 h-1 rounded-full dark:bg-white/20 bg-black/20"></span>

          <div class="flex items-center gap-2">
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
              />
            </svg>
            <span>
              Last Modified:{" "}
              <span class="dark:text-slate-300 text-slate-600">
                {formatDisplayDate(entry.data.dateModified || entry.data.date)}
              </span>
            </span>
          </div>

          <span class="hidden md:block w-1 h-1 rounded-full dark:bg-white/20 bg-black/20"></span>

          <div class="flex items-center gap-2">
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span>
              Reading Time:{" "}
              <span class="dark:text-slate-300 text-slate-600">
                {readingMinutes} min read
              </span>
            </span>
          </div>
        </div>
      </div>

      <!-- Hero image -->
      <img
        src={getOptimizedImageUrl(entry.data.image, 1200)}
        srcset={getImageSrcSet(entry.data.image, [640, 800, 1024, 1200])}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 1200px"
        alt={entry.data.title}
        width="1200"
        height="630"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="w-full h-auto object-cover rounded-2xl mb-8"
        title={entry.data.title}
      />

      {entry.data.series && (
        <SeriesCallout
          seriesName={entry.data.series}
          currentSlug={slug}
          currentOrder={entry.data.seriesOrder}
        />
      )}

      <TableOfContents headings={headings} />

      <div class="max-w-full mt-6 prose dark:prose-invert prose-strong:text-black dark:prose-strong:text-white prose-headings:mt-8 prose-headings:font-semibold prose-h1:text-4xl md:prose-h1:text-5xl prose-h2:text-3xl md:prose-h2:text-4xl prose-h3:text-2xl md:prose-h3:text-3xl prose-h4:text-xl md:prose-h4:text-2xl prose-h5:text-lg md:prose-h5:text-xl prose-h6:text-md prose-img:rounded-2xl">
        <Content
          components={{
            Screenshot,
            img: Screenshot,
            Accordion,
            AccordionItem,
            AccordionTrigger,
            AccordionContent,
            table: Table,
          }}
        />
      </div>
    </article>

    <ShareArticle
      url={canonicalUrl}
      title={entry.data.title}
      hashtags={entry.data.keywords}
    />

    <RelatedArticles articles={relatedArticles} />
    <BlogPostNavigation previous={navigation.previous} next={navigation.next} />
    <CopyButton />
  </div>
</BaseLayout>
