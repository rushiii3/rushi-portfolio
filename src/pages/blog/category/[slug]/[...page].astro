---
// src/pages/blog/category/[slug]/[...page].astro
import type { GetStaticPaths, Page } from "astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import HeroSection from "../../../../components/HeroSection.astro";
import BlogNavTabs from "../../../../components/BlogNavTabs.astro";
import BlogCard from "../../../../components/BlogCard.astro";
import Pagination from "../../../../components/Pagination.astro";
import { getAllBlogs, type BlogPost } from "../../../../lib/content";
import { blogCategories } from "../../../../data/info";
import {
  buildBreadcrumbSchema,
  buildBlogListSchema,
} from "../../../../lib/schemaBuilder";

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allBlogs = await getAllBlogs();
  const categories = blogCategories.filter((c) => c.slug !== "all");

  return categories.flatMap((category) => {
    const categoryBlogs = allBlogs.filter(
      (b) => b.data.category.toLowerCase() === category.name.toLowerCase(),
    );
    return paginate(categoryBlogs, {
      params: { slug: category.slug },
      props: { category },
      pageSize: 10,
    });
  });
};

interface Props {
  page: Page<BlogPost>;
  category: (typeof blogCategories)[number];
}

const { page, category } = Astro.props;
const siteUrl = `${process.env.PUBLIC_URL || import.meta.env.PUBLIC_URL}`;
const isFirstPage = page.currentPage === 1;

const canonical = isFirstPage
  ? `/blog/category/${category.slug}`
  : `/blog/category/${category.slug}/${page.currentPage}`;
const canonicalUrl = `${siteUrl}${canonical}`;

const pageTitle = isFirstPage
  ? `${category.name} Articles`
  : `${category.name} Articles – Page ${page.currentPage}`;

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${siteUrl}/` },
  { name: "Blog", url: `${siteUrl}/blog` },
  { name: category.name, url: `${siteUrl}/blog/category/${category.slug}` },
  ...(isFirstPage
    ? []
    : [{ name: `Page ${page.currentPage}`, url: canonicalUrl }]),
]);

const blogListSchema = buildBlogListSchema({
  siteUrl,
  blogUrl: canonicalUrl,
  blogName: isFirstPage
    ? `${category.name} Articles`
    : `${category.name} Articles – Page ${page.currentPage}`,
  description: category.intro,
  authorUrl: `${siteUrl}/about`,
  posts: page.data.map((b) => ({
    title: b.data.title,
    description: b.data.description,
    slug: b.id.replace(/\.mdx$/, ""),
    date: b.data.date,
    image: b.data.image,
  })),
});

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [blogListSchema, breadcrumbSchema],
};

const keywords = [
  `${category.name} blog`,
  `${category.name} articles`,
  `${category.name} tutorials`,
  "cybersecurity blog",
  "application security",
  "penetration testing",
];
---

<BaseLayout
  title={pageTitle}
  description={category.intro}
  canonical={canonical}
  prevUrl={page.url.prev}
  nextUrl={page.url.next}
  keywords={keywords}
  jsonLd={jsonLdGraph}
>
  <div class="w-full md:pt-14 pt-8 pb-20">
    <HeroSection title={category.name} description={category.intro} />

    <BlogNavTabs activeSlug={category.slug} />

    {page.data.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {page.data.map((blog) => (
          <BlogCard
            article={{
              slug: blog.id.replace(/\.mdx$/, ""),
              title: blog.data.title,
              description: blog.data.description,
              image: blog.data.image,
              date: blog.data.date,
              category: blog.data.category,
            }}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 text-neutral-500">
        <p class="text-lg">No articles published in this category yet.</p>
        <a href="/blog" class="inline-block mt-4 text-primary hover:underline">
          Browse all articles &rarr;
        </a>
      </div>
    )}

    <Pagination
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      baseUrl={`/blog/category/${category.slug}`}
    />
  </div>
</BaseLayout>
