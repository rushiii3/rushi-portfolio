---
// src/pages/work/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../../components/HeroSection.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getAllProjects } from "../../lib/content";
import { buildBreadcrumbSchema } from "../../lib/schemaBuilder";

const siteUrl = `${process.env.PUBLIC_URL || import.meta.env.PUBLIC_URL}`;
const projects = await getAllProjects();

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: `${siteUrl}/` },
  { name: "Projects", url: `${siteUrl}/work` },
]);

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [breadcrumbSchema],
};
---

<BaseLayout
  title="Projects & Security Tools | Hrushikesh Shinde"
  description="Explore cybersecurity tools, full-stack applications, and open-source projects built by Hrushikesh Shinde, including SecureBlog, MeshFlix, and custom security scripts."
  canonical="/work"
  jsonLd={jsonLdGraph}
>
  <div class="w-full md:pt-14 pt-8 pb-20">
    <HeroSection
      title="Work & Projects"
      description="Security testing utilities, vulnerable lab environments, automation scripts, and full-stack web applications."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <ProjectCard
          project={{
            slug: project.id.replace(/\.mdx$/, ""),
            title: project.data.title,
            description: project.data.description,
            image: project.data.image,
            date: project.data.date,
            category: project.data.category,
            type: project.data.type,
            stack: project.data.stack,
            github: project.data.github,
            link: project.data.link,
          }}
        />
      ))}
    </div>
  </div>
</BaseLayout>
